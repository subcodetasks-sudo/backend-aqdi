                                },
                                {
                                    "key": "is_active",
                                    "value": "1",
                                    "type": "text"
                                },
                                {
                                    "key": "image_alt",
                                    "value": "وصف صورة المقال",
                                    "type": "text"
                                },
                                {
                                    "key": "meta_title",
                                    "value": "عنوان SEO",
                                    "type": "text"
                                },
                                {
                                    "key": "meta_description",
                                    "value": "وصف SEO يظهر في نتائج البحث",
                                    "type": "text"
                                },
                                {
                                    "key": "category",
                                    "value": "guides",
                                    "type": "text"
                                },
                                {
                                    "key": "category_label_ar",
                                    "value": "أدلة",
                                    "type": "text"
                                },
                                {
                                    "key": "author",
                                    "value": "فريق عقدي",
                                    "type": "text"
                                },
                                {
                                    "key": "excerpt",
                                    "value": "مقتطف يظهر على بطاقة المقال في القائمة.",
                                    "type": "text"
                                },
                                {
                                    "key": "is_featured",
                                    "value": "0",
