                                    "value": "ijar,guides",
                                    "type": "text"
                                },
                                {
                                    "key": "publish_at",
                                    "value": "",
                                    "type": "text",
                                    "disabled": true
                                },
                                {
                                    "key": "image",
                                    "type": "file",
                                    "src": ""
                                }
