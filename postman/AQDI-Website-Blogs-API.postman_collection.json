{
    "info": {
        "_postman_id": "acf09473-34b4-4105-8079-702904933f6a",
        "name": "AQDI Website — Blogs API",
        "description": "Public JSON API for website / blog-frontend blogs (`/api/blogs`).\n\n**Public (no token)**\n- `GET /api/blogs` — published / due-scheduled, active. Query: `page`, `category`, `tag`, `search`, `per_page`, `sort=latest|popular`, `featured=1`, `fields=`\n- Envelope: `{ data: BlogListItem[], meta: { current_page, last_page, per_page, total } }`\n- `GET /api/blogs/meta` — categories, popular tags, marketing stats\n- `GET /api/blogs/{slug}` — single post. `?preview=1` or `X-No-Track: 1` skips views_count\n- `POST /api/newsletter` — `{ email }`\n\n**SEO CMS (Bearer `{{seo_token}}`)** — unchanged\n- `POST /api/seo/login` then create / update / toggle / delete\n\nAdmin CRUD stays on `/api/admin/blogs` (see AQDI Admin API). This collection is the public website surface.\n\n1. Import this collection.\n2. Set `baseUrl` (e.g. http://localhost:8000).\n3. Run **List published blogs** — saves `blog_slug` / `blog_id`.\n4. For writes, run **SEO login** first (seed: `seo@email.com` / `seo123456`).",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "variable": [
        {
            "key": "baseUrl",
            "value": "http://localhost:8000",
            "type": "string"
        },
        {
            "key": "locale",
            "value": "ar",
            "type": "string"
        },
        {
            "key": "seo_token",
            "value": "",
            "type": "string"
        },
        {
            "key": "blog_slug",
            "value": "how-to-certify-rental-contract-online",
            "type": "string"
        },
        {
            "key": "blog_id",
            "value": "1",
            "type": "string"
        },
        {
            "key": "seo_email",
            "value": "seo@email.com",
            "type": "string"
        },
        {
            "key": "seo_password",
            "value": "seo123456",
            "type": "string"
        }
    ],
    "item": [
        {
            "name": "1 — Public JSON (website / blog frontend)",
            "description": "Active published posts, or scheduled posts whose publish_at has passed. Default 6 per page. List envelope is `{ data, meta }`.",
            "item": [
                {
                    "name": "List published blogs",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application/json",
                                "type": "text"
                            },
                            {
                                "key": "Accept-Language",
                                "value": "{{locale}}",
                                "type": "text"
                            }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}/api/blogs?page=1",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "blogs"
                            ],
                            "query": [
                                {
                                    "key": "page",
                                    "value": "1"
                                },
                                {
                                    "key": "per_page",
                                    "value": "6",
                                    "disabled": true
                                },
                                {
                                    "key": "category",
                                    "value": "contracts",
                                    "disabled": true
                                },
                                {
                                    "key": "tag",
                                    "value": "ijar",
                                    "disabled": true
                                },
                                {
                                    "key": "search",
                                    "value": "عقد إيجار",
                                    "disabled": true
                                },
                                {
                                    "key": "sort",
                                    "value": "latest",
                                    "disabled": true
                                }
                            ]
                        },
                        "description": "Returns published (or due scheduled) active blogs as BlogListItem[] (no HTML body). Envelope: data + meta. Saves first item slug/id. Empty list is 200 with data []."
                    },
                    "response": [],
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "const json = pm.response.json();",
                                    "const items = Array.isArray(json?.data) ? json.data : [];",
                                    "const first = items[0];",
                                    "if (first?.slug) { pm.collectionVariables.set(\"blog_slug\", String(first.slug)); }",
                                    "if (first?.id) { pm.collectionVariables.set(\"blog_id\", String(first.id)); }"
                                ]
                            }
                        }
                    ]
                },
                {
                    "name": "List by category",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application/json",
                                "type": "text"
                            },
                            {
                                "key": "Accept-Language",
                                "value": "{{locale}}",
                                "type": "text"
                            }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}/api/blogs?category=contracts&page=1",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "blogs"
                            ],
                            "query": [
                                {
                                    "key": "category",
                                    "value": "contracts"
                                },
                                {
                                    "key": "page",
                                    "value": "1"
                                }
                            ]
                        },
                        "description": "Filter by category slug. Canonical slugs: property-management, contracts, real-estate-market, guides."
                    },
                    "response": []
                },
                {
                    "name": "List featured (hero)",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application/json",
                                "type": "text"
                            },
                            {
                                "key": "Accept-Language",
                                "value": "{{locale}}",
                                "type": "text"
                            }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}/api/blogs?featured=1",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "blogs"
                            ],
                            "query": [
                                {
                                    "key": "featured",
                                    "value": "1"
                                }
                            ]
                        },
                        "description": "Editor-picked posts (`is_featured=1`). Default per_page is 4. List items also include `is_featured` so the hero can be taken from a normal list."
                    },
                    "response": []
                },
                {
                    "name": "Sitemap slim list",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application/json",
                                "type": "text"
                            },
                            {
                                "key": "Accept-Language",
                                "value": "{{locale}}",
                                "type": "text"
                            }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}/api/blogs?per_page=1000&fields=slug%2Cupdated_at",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "blogs"
                            ],
                            "query": [
                                {
                                    "key": "per_page",
                                    "value": "1000"
                                },
                                {
                                    "key": "fields",
                                    "value": "slug,updated_at"
                                }
                            ]
                        },
                        "description": "One-shot sitemap payload. `meta.last_page` is accurate; or use fields=slug,updated_at with a large per_page."
                    },
                    "response": []
                },
                {
                    "name": "Blog taxonomy meta",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application/json",
                                "type": "text"
                            },
                            {
                                "key": "Accept-Language",
                                "value": "{{locale}}",
                                "type": "text"
                            }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}/api/blogs/meta",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "blogs",
                                "meta"
                            ]
                        },
                        "description": "Cached sidebar payload: canonical categories with posts_count, popular tags, marketing stats (إيجار بأرقام)."
                    },
                    "response": []
                },
                {
                    "name": "Show blog by slug",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application/json",
                                "type": "text"
                            },
                            {
                                "key": "Accept-Language",
                                "value": "{{locale}}",
                                "type": "text"
                            }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}/api/blogs/{{blog_slug}}",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "blogs",
                                "{{blog_slug}}"
                            ]
                        },
                        "description": "Single post by slug. Increments views_count unless `preview=1` or `X-No-Track: 1`. 404 when unpublished or missing. Includes tags, related_posts, prev/next, sanitized content."
                    },
                    "response": []
                },
                {
                    "name": "Show blog — preview (no view increment)",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application/json",
                                "type": "text"
                            },
                            {
                                "key": "Accept-Language",
                                "value": "{{locale}}",
                                "type": "text"
                            }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}/api/blogs/{{blog_slug}}?preview=1",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "blogs",
                                "{{blog_slug}}"
                            ],
                            "query": [
                                {
                                    "key": "preview",
                                    "value": "1"
                                }
                            ]
                        },
                        "description": "ISR / bot revalidation. Does not increment views_count."
                    },
                    "response": []
                },
                {
                    "name": "Show blog — not found",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application/json",
                                "type": "text"
                            },
                            {
                                "key": "Accept-Language",
                                "value": "{{locale}}",
                                "type": "text"
                            }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}/api/blogs/this-slug-does-not-exist",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "blogs",
                                "this-slug-does-not-exist"
                            ]
                        },
                        "description": "Expect 404 and `{ message }`."
                    },
                    "response": []
                },
                {
                    "name": "Subscribe newsletter",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application/json",
                                "type": "text"
                            },
                            {
                                "key": "Accept-Language",
                                "value": "{{locale}}",
                                "type": "text"
                            },
                            {
                                "key": "Content-Type",
                                "value": "application/json",
                                "type": "text"
                            }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}/api/newsletter",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "newsletter"
                            ]
                        },
                        "description": "Single opt-in, stored locally (no third-party provider / no double opt-in). Duplicate email still returns 200. Invalid email is 422 `{ message, errors.email }`.",
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"email\": \"user@example.com\"\n}",
                            "options": {
                                "raw": {
                                    "language": "json"
                                }
                            }
                        }
                    },
                    "response": []
                }
            ]
        },
        {
            "name": "2 — SEO login",
            "description": "Blog-subdomain CMS login (`seos` table, `seo` guard). Token is a Sanctum personal access token.",
            "item": [
                {
                    "name": "SEO login (save token)",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application/json",
                                "type": "text"
                            },
                            {
                                "key": "Accept-Language",
                                "value": "{{locale}}",
                                "type": "text"
                            },
                            {
                                "key": "Content-Type",
                                "value": "application/json",
                                "type": "text"
                            }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}/api/seo/login",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "seo",
                                "login"
                            ]
                        },
                        "description": "Saves `data.token` to `seo_token`. Seed user: seo@email.com / seo123456.",
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"email\": \"{{seo_email}}\",\n    \"password\": \"{{seo_password}}\"\n}",
                            "options": {
                                "raw": {
                                    "language": "json"
                                }
                            }
                        }
                    },
                    "response": [],
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "const json = pm.response.json();",
                                    "const token = json?.data?.token ?? json?.token;",
                                    "if (token) {",
                                    "  pm.collectionVariables.set(\"seo_token\", token);",
                                    "}"
                                ]
                            }
                        }
                    ]
                }
            ]
        },
        {
            "name": "3 — SEO CMS (write)",
            "description": "Requires Bearer `{{seo_token}}`. Image upload is multipart/form-data. Admin panel CRUD is still `/api/admin/blogs`.",
            "item": [
                {
                    "name": "Create blog",
                    "request": {
                        "method": "POST",
                        "header": [
