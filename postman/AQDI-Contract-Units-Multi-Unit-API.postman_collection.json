        {
            "name": "2) Step 5 — multi units (NEW)",
            "item": [
                {
                    "name": "Step 5 — create multiple NEW units",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application/json",
                                "type": "text"
                            },
                            {
                                "key": "Content-Type",
                                "value": "application/json",
                                "type": "text"
                            },
                            {
                                "key": "Authorization",
                                "value": "Bearer {{token}}",
                                "type": "text"
                            }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}/api/v2/contract/step5",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "v2",
                                "contract",
                                "step5"
                            ]
                        },
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"id\": \"{{contract_id}}\",\n    \"units\": [\n        {\n            \"unit_type_id\": 1,\n            \"unit_usage_id\": 1,\n            \"unit_number\": \"101\",\n            \"floor_number\": 1,\n            \"unit_area\": 120,\n            \"tootal_rooms\": 3,\n            \"The_number_of_halls\": 1,\n            \"The_number_of_kitchens\": 1,\n            \"The_number_of_toilets\": 2,\n            \"window_ac\": 0,\n            \"split_ac\": 2,\n            \"electricity_meter_number\": \"E-1001\",\n            \"water_meter_number\": \"W-1001\",\n            \"kitchen_tank\": false,\n            \"furnished\": true,\n            \"type_furnished\": \"partial\",\n            \"electricity_meter\": true,\n            \"water_meter\": true,\n            \"electricity_meter_ownership\": \"owner\",\n            \"water_meter_ownership\": \"tenant\"\n        },\n        {\n            \"unit_type_id\": 1,\n            \"unit_usage_id\": 1,\n            \"unit_number\": \"102\",\n            \"floor_number\": 1,\n            \"unit_area\": 90,\n            \"tootal_rooms\": 2,\n            \"split_ac\": 1,\n            \"kitchen_tank\": false,\n            \"furnished\": false,\n            \"electricity_meter\": true,\n            \"water_meter\": false\n        }\n    ]\n}",
                            "options": {
                                "raw": {
                                    "language": "json"
                                }
                            }
                        },
                        "description": "Creates 1+ units in `real_units` and links them via `contract_units`.\n\nDoes NOT write unit details into `contracts` columns anymore.\nOnly advances `step` to 6 and sets legacy `real_units_id` = first unit.\n\nResponse includes:\n- data.units[]\n- data.units_count\n- units_count"
                    },
                    "response": []
                },
                {
                    "name": "Step 5 — attach existing unit_ids",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application/json",
                                "type": "text"
                            },
                            {
                                "key": "Content-Type",
                                "value": "application/json",
                                "type": "text"
                            },
                            {
                                "key": "Authorization",
                                "value": "Bearer {{token}}",
                                "type": "text"
                            }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}/api/v2/contract/step5",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "v2",
                                "contract",
                                "step5"
                            ]
                        },
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"id\": \"{{contract_id}}\",\n    \"unit_ids\": [\n        10,\n        11\n    ]\n}",
                            "options": {
                                "raw": {
                                    "language": "json"
                                }
                            }
                        },
                        "description": "Attach existing real_units owned by the authenticated user."
                    },
                    "response": []
                },
                {
                    "name": "Step 5 — mix existing + new units",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application/json",
                                "type": "text"
                            },
                            {
                                "key": "Content-Type",
                                "value": "application/json",
                                "type": "text"
                            },
                            {
                                "key": "Authorization",
                                "value": "Bearer {{token}}",
                                "type": "text"
                            }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}/api/v2/contract/step5",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "v2",
                                "contract",
                                "step5"
                            ]
                        },
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"id\": \"{{contract_id}}\",\n    \"units\": [\n        {\n            \"unit_id\": \"{{unit_id}}\"\n        },\n        {\n            \"unit_type_id\": 1,\n            \"unit_usage_id\": 1,\n            \"unit_number\": \"102\",\n            \"floor_number\": 1,\n            \"unit_area\": 90,\n            \"tootal_rooms\": 2,\n            \"split_ac\": 1,\n            \"kitchen_tank\": false,\n            \"furnished\": false,\n            \"electricity_meter\": true,\n            \"water_meter\": false\n        }\n    ]\n}",
                            "options": {
                                "raw": {
                                    "language": "json"
                                }
                            }
                        },
                        "description": "units[].unit_id (or id / real_unit_id) attaches existing unit; other objects create new units."
                    },
                    "response": []
                },
