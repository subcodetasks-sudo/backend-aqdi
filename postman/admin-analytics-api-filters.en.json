{
  "title": "Admin Analytics API Filters",
  "description": "Query and path parameters for admin analytics endpoints. Base URL prefix: /api/admin",
  "version": "1.0.0",
  "base_path": "/api/admin",
  "shared_query_parameters": {
    "limit": {
      "type": "integer",
      "default": 10,
      "min": 1,
      "max": 100,
      "description": "Max rows in metric list (clients, employees, contract-status preview)."
    },
    "per_page": {
      "type": "integer",
      "default": 20,
      "min": 1,
      "max": 100,
      "description": "Pagination page size for contract/refund lists."
    }
  },
  "time_filters": {
    "created_at": {
      "description": "Contract-status analytics period filter.",
      "used_by": ["analytics.contract-status.show", "analytics.contract-status.contracts"],
      "canonical_values": ["day", "week", "month", "year", "total"],
      "aliases": {
        "day": ["today", "daily"],
        "week": ["weekly"],
        "month": ["monthly"],
        "year": ["yearly"],
        "total": ["all"]
      },
      "behavior": {
        "omitted": "Returns all period cards (summary) on show endpoint.",
        "provided": "Returns single period metric + OrderResource contracts list."
      },
      "examples": [
        "/analytics/contract-status/2?created_at=day",
        "/analytics/contract-status/2?created_at=month&limit=10",
        "/analytics/contract-status/3/contracts?created_at=week&per_page=20"
      ]
    },
    "period": {
      "description": "Refunds (returned contracts) time filter. Legacy alias on contract-status contracts.",
      "used_by": ["analytics.refunds.contracts.index", "analytics.contract-status.contracts"],
      "canonical_values": ["today", "week", "month", "year", "total"],
      "default": "today",
      "examples": [
        "/analytics/refunds/contracts?period=today",
        "/analytics/refunds/contracts?period=month&per_page=20"
      ]
    }
  },
  "endpoints": [
    {
      "group": "dashboard",
      "name": "Full dashboard analytics",
      "method": "GET",
      "path": "/analytics",
      "aliases": ["/analytics/all", "/dashboard-analytics"],
      "query_parameters": []
    },
    {
      "group": "users",
      "name": "User activity rate",
      "method": "GET",
      "path": "/analytics/user-activity-rate",
      "aliases": [],
      "query_parameters": []
    },
    {
      "group": "clients",
      "name": "Top customers — completed orders",
      "method": "GET",
      "path": "/analytics/top-customers/completed-orders",
      "aliases": ["/analytics/clients/completed-orders"],
      "query_parameters": ["limit"]
    },
    {
      "group": "clients",
      "name": "Top customers — incomplete orders",
      "method": "GET",
      "path": "/analytics/top-customers/incomplete-orders",
      "aliases": ["/analytics/clients/incomplete-orders"],
      "query_parameters": ["limit"]
    },
    {
      "group": "clients",
      "name": "Top customers — total orders",
      "method": "GET",
      "path": "/analytics/top-customers/orders",
      "aliases": ["/analytics/clients/orders"],
      "query_parameters": ["limit"]
    },
    {
      "group": "clients",
      "name": "Top customers — returns",
      "method": "GET",
      "path": "/analytics/top-customers/returns",
      "aliases": ["/analytics/clients/returns"],
      "query_parameters": ["limit"]
    },
    {
      "group": "clients",
      "name": "Top customers — real estates",
      "method": "GET",
      "path": "/analytics/top-customers/real-estates",
      "aliases": ["/analytics/clients/real-estates"],
      "query_parameters": ["limit"]
    },
    {
      "group": "clients",
      "name": "Top customers — units",
      "method": "GET",
      "path": "/analytics/top-customers/units",
      "aliases": ["/analytics/clients/units"],
      "query_parameters": ["limit"]
    },
    {
      "group": "refunds",
      "name": "Returned contracts list",
      "method": "GET",
      "path": "/analytics/refunds/contracts",
      "query_parameters": [
        {
          "name": "period",
          "type": "string",
          "required": false,
          "default": "today",
          "allowed_values": ["today", "week", "month", "year", "total"]
        },
        {
          "name": "per_page",
          "type": "integer",
          "required": false,
          "default": 20,
          "min": 1,
          "max": 100
        },
        {
          "name": "admin_confirmed",
          "type": "boolean",
          "required": false,
          "description": "Filter management approval. true = approved, false = not approved."
        },
        {
          "name": "contract_status_id",
          "type": "integer",
          "required": false,
          "description": "Filter by related contract status id from contract_statuses table."
        }
      ],
      "response_summary_keys": ["management_approval", "contract_statuses"]
    },
    {
      "group": "refunds",
      "name": "Submit refund request (employee)",
      "method": "POST",
      "path": "/refundable-contracts",
      "auth": "Bearer employee_token",
      "description": "Contract must be from GET /orders/return (contract_status_id = 2).",
      "body": {
        "contract_id": { "type": "integer", "required": false, "example": 42, "description": "From orders/return list (preferred)" },
        "draft_contract_number": { "type": "string", "required": false, "example": "000042" },
        "refund_amount": { "type": "number", "required": true, "example": 500 },
        "notes": { "type": "string", "required": false }
      }
    },
    {
      "group": "refunds",
      "name": "Management approval — accept or reject",
      "method": "POST",
      "path": "/analytics/refunds/contracts/{id}",
      "path_parameters": [
        {
          "name": "id",
          "type": "integer",
          "description": "refundable_contracts.id"
        }
      ],
      "body": {
        "admin_confirmed": {
          "type": "boolean",
          "required": true,
          "description": "true = الموافقة على الإرجاع, false = لم تتم الموافقة"
        },
        "refund_amount": { "type": "number", "required": false, "description": "Override amount; omit to keep value from request" },
        "notes": { "type": "string", "required": false }
      }
    },
    {
      "group": "refunds",
      "name": "Returned contract detail",
      "method": "GET",
      "path": "/analytics/refunds/contracts/{id}",
      "path_parameters": [
        {
          "name": "id",
          "type": "integer",
          "description": "refundable_contracts.id"
        }
      ],
      "query_parameters": []
    },
    {
      "group": "contract_status",
      "name": "Contracts by status — summary or single period",
      "method": "GET",
      "path": "/analytics/contract-status/{contractStatusId}",
      "path_parameters": [
        {
          "name": "contractStatusId",
          "type": "integer",
          "description": "contract_statuses.id (e.g. 2 = under review, 3 = completed)."
        }
      ],
      "query_parameters": [
        {
          "name": "created_at",
          "type": "string",
          "required": false,
          "allowed_values": ["day", "week", "month", "year", "total"],
          "aliases": {
            "day": ["today", "daily"],
            "week": ["weekly"],
            "month": ["monthly"],
            "year": ["yearly"],
            "total": ["all"]
          }
        },
        {
          "name": "limit",
          "type": "integer",
          "required": false,
          "default": 10,
          "min": 1,
          "max": 100
        }
      ]
    },
    {
      "group": "contract_status",
      "name": "Contracts by status — paginated list",
      "method": "GET",
      "path": "/analytics/contract-status/{contractStatusId}/contracts",
      "path_parameters": [
        {
          "name": "contractStatusId",
          "type": "integer"
        }
      ],
      "query_parameters": [
        {
          "name": "created_at",
          "type": "string",
          "required": false,
          "allowed_values": ["day", "week", "month", "year", "total"]
        },
        {
          "name": "period",
          "type": "string",
          "required": false,
          "description": "Legacy alias for created_at (uses today|week|month|year|total mapping)."
        },
        {
          "name": "per_page",
          "type": "integer",
          "required": false,
          "default": 20,
          "min": 1,
          "max": 100
        }
      ]
    },
    {
      "group": "employees",
      "name": "Top employee — most received orders",
      "method": "GET",
      "path": "/analytics/employees/most-received-orders",
      "query_parameters": ["limit"]
    },
    {
      "group": "employees",
      "name": "Top employee — most returns submitted",
      "method": "GET",
      "path": "/analytics/employees/most-returns",
      "query_parameters": ["limit"]
    },
    {
      "group": "employees",
      "name": "Top employee — most documented orders",
      "method": "GET",
      "path": "/analytics/employees/most-documented-orders",
      "query_parameters": ["limit"]
    },
    {
      "group": "employees",
      "name": "Total employees count",
      "method": "GET",
      "path": "/analytics/employees/count",
      "query_parameters": []
    },
    {
      "group": "employees",
      "name": "Top employee — most unpaid orders",
      "method": "GET",
      "path": "/analytics/employees/most-unpaid-orders",
      "query_parameters": ["limit"]
    }
  ],
  "orders_endpoints": [
    {
      "name": "List orders",
      "method": "GET",
      "path": "/orders",
      "query_parameters": ["per_page", "page", "is_completed", "status", "contract_status_id", "search", "is_received"]
    },
    {
      "name": "Return orders (for refunds)",
      "method": "GET",
      "path": "/orders/return",
      "description": "contract_status_id = 2. Use contract id when POST /refundable-contracts."
    },
    {
      "name": "Incomplete orders",
      "method": "GET",
      "path": "/orders/incomplete/list",
      "description": "is_completed = 0, is_delete = 0"
    },
    {
      "name": "Complete orders",
      "method": "GET",
      "path": "/orders/complete/list",
      "description": "is_completed = 1"
    },
    {
      "name": "Show contract",
      "method": "GET",
      "path": "/orders/{id}"
    },
    {
      "name": "Update contract (partial)",
      "method": "POST",
      "path": "/orders/{id}",
      "description": "Any contract column except id, uuid, timestamps. Send only fields to change."
    },
    {
      "name": "Update contract status",
      "method": "POST",
      "path": "/orders/{id}/contract-status",
      "body": { "contract_status_id": { "type": "integer", "required": true } }
    }
  ],
  "instruction_sections_endpoints": [
    {
      "name": "List instruction sections",
      "method": "GET",
      "path": "/instruction-sections",
      "query_parameters": ["per_page"]
    },
    {
      "name": "Show section",
      "method": "GET",
      "path": "/instruction-sections/{id}"
    },
    {
      "name": "Update section",
      "method": "POST",
      "path": "/instruction-sections/{id}",
      "body": {
        "title_ar": { "type": "string", "required": false },
        "description_ar": { "type": "string", "required": false },
        "is_active": { "type": "boolean", "required": false },
        "sort_order": { "type": "integer", "required": false }
      }
    },
    {
      "name": "Toggle active",
      "method": "POST",
      "path": "/instruction-sections/{id}/toggle",
      "body": { "is_active": { "type": "boolean", "required": true } }
    },
    {
      "name": "Delete section",
      "method": "POST",
      "path": "/instruction-sections/{id}/delete"
    },
    {
      "name": "Upload image",
      "method": "POST",
      "path": "/instruction-sections/{id}/images",
      "content_type": "multipart/form-data",
      "body": {
        "image": { "type": "file", "required": true },
        "title_ar": { "type": "string", "required": false },
        "sort_order": { "type": "integer", "required": false }
      }
    },
    {
      "name": "Delete image",
      "method": "POST",
      "path": "/instruction-sections/{id}/images/{imageId}/delete"
    }
  ],
  "postman_collection": "postman/AQDI-Admin-Orders-Refunds-Instructions.postman_collection.json",
  "payments_filter": {
    "description": "Payments screen time filter.",
    "method": "GET",
    "path": "/payments",
    "query_parameters": [
      {
        "name": "filter",
        "type": "string",
        "allowed_values": ["today", "week", "month", "year"]
      },
      {
        "name": "per_page",
        "type": "integer",
        "default": 20
      }
    ]
  }
}
