        {
            "name": "2. Create",
            "item": [
                {
                    "name": "Create One Unit",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application\/json",
                                "type": "text"
                            },
                            {
                                "key": "Content-Type",
                                "value": "application\/json",
                                "type": "text"
                            }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}\/api\/v2\/unit\/create",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "v2",
                                "unit",
                                "create"
                            ]
                        },
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"real_estates_units_id\": \"{{real_estate_id}}\",\n    \"units\": [\n        {\n            \"contract_type\": \"housing\",\n            \"unit_type_id\": 1,\n            \"unit_usage_id\": 1,\n            \"unit_number\": \"101\",\n            \"floor_number\": 1,\n            \"unit_area\": 120,\n            \"tootal_rooms\": 3,\n            \"The_number_of_toilets\": 2,\n            \"The_number_of_kitchens\": 1,\n            \"split_ac\": 0,\n            \"window_ac\": 0,\n            \"kitchen_tank\": false,\n            \"furnished\": false,\n            \"electricity_meter\": false,\n            \"water_meter\": false\n        }\n    ]\n}",
                            "options": {
                                "raw": {
                                    "language": "json"
                                }
                            }
                        },
                        "description": "Create a single residential unit (`units` with 1 item).\n\nRequired per unit: `unit_type_id`, `unit_usage_id`, `unit_number`, `floor_number`, `unit_area`, `tootal_rooms`.\n\n`contract_type`: `housing` (سكني) or `commercial` (تجاري). If omitted, inherited from the property.\n\nKitchen cabinets (`kitchen_tank` or `kitchen_cabinets`) require `The_number_of_kitchens` >= 1.\n\nSaves `unit_id` from `data.created[0].id`."
                    },
                    "response": [],
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text\/javascript",
                                "exec": [
                                    "const json = pm.response.json();",
                                    "const unitId = json?.data?.created?.[0]?.id || json?.data?.id;",
                                    "if (unitId) { pm.collectionVariables.set(\"unit_id\", String(unitId)); }"
                                ]
                            }
                        }
                    ]
                },
                {
                    "name": "Create Multiple Units",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application\/json",
                                "type": "text"
                            },
                            {
                                "key": "Content-Type",
                                "value": "application\/json",
                                "type": "text"
                            }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}\/api\/v2\/unit\/create",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "v2",
                                "unit",
                                "create"
                            ]
                        },
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"real_estates_units_id\": \"{{real_estate_id}}\",\n    \"units\": [\n        {\n            \"contract_type\": \"housing\",\n            \"unit_type_id\": 1,\n            \"unit_usage_id\": 1,\n            \"unit_number\": \"101\",\n            \"floor_number\": 1,\n            \"unit_area\": 120,\n            \"tootal_rooms\": 3,\n            \"The_number_of_toilets\": 2,\n            \"The_number_of_kitchens\": 1,\n            \"split_ac\": 0,\n            \"window_ac\": 0,\n            \"kitchen_tank\": false,\n            \"furnished\": false,\n            \"electricity_meter\": false,\n            \"water_meter\": false\n        },\n        {\n            \"contract_type\": \"housing\",\n            \"unit_type_id\": 1,\n            \"unit_usage_id\": 1,\n            \"unit_number\": \"102\",\n            \"floor_number\": 1,\n            \"unit_area\": 90,\n            \"tootal_rooms\": 2,\n            \"The_number_of_toilets\": 1,\n            \"The_number_of_kitchens\": 1,\n            \"split_ac\": 1,\n            \"window_ac\": 0,\n            \"kitchen_tank\": true,\n            \"furnished\": false,\n            \"electricity_meter\": true,\n            \"water_meter\": false\n        }\n    ]\n}",
                            "options": {
                                "raw": {
                                    "language": "json"
                                }
                            }
                        },
                        "description": "Create 2+ units in one request (max 50). Same endpoint as Create One Unit.\n\nResponse:\n- `data.created` — units created in this call\n- `data.created_count`\n- `data.units` — all units on the property\n- `data.units_count`\n\nSaves `unit_id` from the first created unit."
                    },
                    "response": [],
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text\/javascript",
                                "exec": [
                                    "const json = pm.response.json();",
                                    "const unitId = json?.data?.created?.[0]?.id || json?.data?.id;",
                                    "if (unitId) { pm.collectionVariables.set(\"unit_id\", String(unitId)); }"
                                ]
                            }
                        }
                    ]
                },
                {
                    "name": "Create Commercial Unit",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application\/json",
                                "type": "text"
                            },
                            {
                                "key": "Content-Type",
                                "value": "application\/json",
                                "type": "text"
                            }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}\/api\/v2\/unit\/create",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "v2",
                                "unit",
                                "create"
                            ]
                        },
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"real_estates_units_id\": \"{{real_estate_id}}\",\n    \"units\": [\n        {\n            \"contract_type\": \"commercial\",\n            \"unit_type_id\": 8,\n            \"unit_usage_id\": 2,\n            \"unit_number\": \"C-1\",\n            \"floor_number\": 0,\n            \"unit_area\": 80,\n            \"tootal_rooms\": 0,\n            \"The_number_of_toilets\": 1,\n            \"The_number_of_kitchens\": 0,\n            \"split_ac\": 2,\n            \"window_ac\": 0,\n            \"kitchen_tank\": false,\n            \"furnished\": false,\n            \"electricity_meter\": true,\n            \"water_meter\": true\n        }\n    ]\n}",
                            "options": {
                                "raw": {
                                    "language": "json"
                                }
                            }
                        },
                        "description": "تجاري. `unit_type_id` \/ `unit_usage_id` must belong to `contract_type=commercial` (see Lookups)."
                    },
                    "response": [],
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text\/javascript",
                                "exec": [
                                    "const json = pm.response.json();",
                                    "const unitId = json?.data?.created?.[0]?.id || json?.data?.id;",
                                    "if (unitId) { pm.collectionVariables.set(\"unit_id\", String(unitId)); }"
                                ]
                            }
                        }
                    ]
                }
            ],
            "description": "POST \/api\/v2\/unit\/create — one or more units on an existing property (`real_estates_units_id`)."
        },
