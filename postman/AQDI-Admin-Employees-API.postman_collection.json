{
    "info": {
        "_postman_id": "aqdi-admin-employees-api",
        "name": "AQDI Admin — Employees API",
        "description": "Employee endpoints only under `/api/admin/employees`.\n\n**Variables**\n- `baseUrl` — e.g. `http://localhost:8000`\n- `employee_token` — set automatically after **Login** (or paste manually)\n- `employee_id` — employee id for show/update/salary/note routes\n\n**Auth:** Bearer token (Sanctum) on all routes except Login.",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "variable": [
        {
            "key": "baseUrl",
            "value": "http://localhost:8000"
        },
        {
            "key": "employee_token",
            "value": ""
        },
        {
            "key": "employee_id",
            "value": "1"
        }
    ],
    "auth": {
        "type": "bearer",
        "bearer": [
            {
                "key": "token",
                "value": "{{employee_token}}",
                "type": "string"
            }
        ]
    },
    "item": [
        {
            "name": "Auth",
            "item": [
                {
                    "name": "Login",
                    "request": {
                        "auth": {
                            "type": "noauth"
                        },
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            },
                            {
                                "key": "Accept",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"email\": \"employee@example.com\",\n    \"password\": \"password123\"\n}",
                            "options": {
                                "raw": {
                                    "language": "json"
                                }
                            }
                        },
                        "url": "{{baseUrl}}/api/admin/employees/login",
                        "description": "Returns `data.token` and full employee in `data.employee`."
                    },
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "const json = pm.response.json();",
                                    "const token = json?.data?.token;",
                                    "if (token) {",
                                    "    pm.collectionVariables.set('employee_token', token);",
                                    "}",
                                    "const employeeId = json?.data?.employee?.id;",
                                    "if (employeeId) {",
                                    "    pm.collectionVariables.set('employee_id', String(employeeId));",
                                    "}"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ]
                },
                {
                    "name": "Logout",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application/json"
                            }
                        ],
                        "url": "{{baseUrl}}/api/admin/employees/logout"
                    }
                }
            ]
        },
        {
            "name": "Employees",
            "item": [
                {
                    "name": "List employees",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application/json"
                            }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}/api/admin/employees?search=&sort_by=created_at&sort_order=desc&per_page=15",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "admin",
                                "employees"
                            ],
                            "query": [
                                {
                                    "key": "search",
                                    "value": "",
                                    "description": "name, email, or phone"
                                },
                                {
                                    "key": "sort_by",
                                    "value": "created_at",
                                    "description": "created_at | name | email | id"
                                },
                                {
                                    "key": "sort_order",
                                    "value": "desc",
                                    "description": "asc | desc"
                                },
                                {
                                    "key": "per_page",
                                    "value": "15",
                                    "description": "1-100"
                                }
                            ]
                        }
                    }
                },
                {
                    "name": "Create employee",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "formdata",
                            "formdata": [
                                {
                                    "key": "name",
                                    "value": "Ahmed Ali",
                                    "type": "text"
                                },
                                {
                                    "key": "email",
                                    "value": "ahmed@example.com",
                                    "type": "text"
                                },
                                {
                                    "key": "password",
                                    "value": "password123",
                                    "type": "text"
                                },
                                {
                                    "key": "phone",
                                    "value": "0500000000",
                                    "type": "text"
                                },
                                {
                                    "key": "base_salary",
                                    "value": "5000",
                                    "type": "text"
                                },
                                {
                                    "key": "role_id",
                                    "value": "1",
                                    "type": "text"
                                },
                                {
                                    "key": "is_active",
                                    "value": "1",
                                    "type": "text"
                                },
                                {
                                    "key": "facebook",
                                    "value": "",
                                    "type": "text",
                                    "disabled": true
                                },
                                {
                                    "key": "instagram",
                                    "value": "",
                                    "type": "text",
                                    "disabled": true
                                },
                                {
                                    "key": "whatsapp",
                                    "value": "",
                                    "type": "text",
                                    "disabled": true
                                },
                                {
                                    "key": "profile_image",
                                    "type": "file",
                                    "src": [],
                                    "disabled": true
                                }
                            ]
                        },
                        "url": "{{baseUrl}}/api/admin/employees",
                        "description": "Returns full employee: salaries, notes, received_contracts, refundable_contracts."
                    }
                },
                {
                    "name": "Create employee (JSON)",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            },
                            {
                                "key": "Accept",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"name\": \"Ahmed Ali\",\n    \"email\": \"ahmed@example.com\",\n    \"password\": \"password123\",\n    \"phone\": \"0500000000\",\n    \"base_salary\": 5000,\n    \"role_id\": 1,\n    \"is_active\": true,\n    \"facebook\": null,\n    \"instagram\": null,\n    \"whatsapp\": null,\n    \"snapchat\": null,\n    \"tiktok\": null,\n    \"twitter\": null\n}",
                            "options": {
                                "raw": {
                                    "language": "json"
                                }
                            }
                        },
                        "url": "{{baseUrl}}/api/admin/employees",
                        "description": "Use without profile_image. Returns full employee payload."
                    }
                },
                {
                    "name": "Show employee",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application/json"
                            }
                        ],
                        "url": "{{baseUrl}}/api/admin/employees/{{employee_id}}",
                        "description": "Full employee with salaries, notes, received_contracts, refundable_contracts."
                    }
                },
                {
                    "name": "Update employee",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            },
                            {
                                "key": "Accept",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"name\": \"Ahmed Ali Updated\",\n    \"phone\": \"0500000001\",\n    \"base_salary\": 5500,\n    \"is_active\": true\n}",
                            "options": {
                                "raw": {
                                    "language": "json"
                                }
                            }
                        },
                        "url": "{{baseUrl}}/api/admin/employees/{{employee_id}}",
                        "description": "Returns full employee payload after update."
                    }
                },
                {
                    "name": "Delete employee",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application/json"
                            }
                        ],
                        "url": "{{baseUrl}}/api/admin/employees/{{employee_id}}/delete"
                    }
                },
                {
                    "name": "Toggle status",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application/json"
                            }
                        ],
                        "url": "{{baseUrl}}/api/admin/employees/{{employee_id}}/toggle-status"
                    }
                },
                {
                    "name": "Block employee",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            },
                            {
                                "key": "Accept",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"blocked_until\": \"2026-12-31 23:59:59\",\n    \"reason_of_block\": \"سبب الحظر\"\n}",
                            "options": {
                                "raw": {
                                    "language": "json"
                                }
                            }
                        },
                        "url": "{{baseUrl}}/api/admin/employees/{{employee_id}}/block"
                    }
                },
                {
                    "name": "Unblock employee",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application/json"
                            }
                        ],
                        "url": "{{baseUrl}}/api/admin/employees/{{employee_id}}/unblock"
                    }
                }
            ]
        },
        {
            "name": "Salaries",
            "item": [
                {
                    "name": "List employee salaries",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application/json"
                            }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}/api/admin/employees/employee-salary?employee_id={{employee_id}}&per_page=20",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "admin",
                                "employees",
                                "employee-salary"
                            ],
                            "query": [
                                {
                                    "key": "employee_id",
                                    "value": "{{employee_id}}",
                                    "description": "optional — omit for all employees"
                                },
                                {
                                    "key": "per_page",
                                    "value": "20"
                                }
                            ]
                        }
                    }
                },
                {
                    "name": "Add employee salary",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            },
                            {
                                "key": "Accept",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"addition_date\": \"2026-05-17\",\n    \"due_date\": \"2026-05-31\",\n    \"basic_salary\": 5000,\n    \"deduction\": 200,\n    \"bonus\": 500,\n    \"total\": 5300\n}",
                            "options": {
                                "raw": {
                                    "language": "json"
                                }
                            }
                        },
                        "url": "{{baseUrl}}/api/admin/employees/{{employee_id}}/salary",
                        "description": "total = basic_salary - deduction + bonus"
                    }
                }
            ]
        },
        {
            "name": "Notes",
            "item": [
                {
                    "name": "List employee notes",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application/json"
                            }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}/api/admin/employees/employee-notes?employee_id={{employee_id}}&per_page=20",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "admin",
                                "employees",
                                "employee-notes"
                            ],
                            "query": [
                                {
                                    "key": "employee_id",
                                    "value": "{{employee_id}}",
                                    "description": "optional — omit for all employees"
                                },
                                {
                                    "key": "per_page",
                                    "value": "20"
                                }
                            ]
                        }
                    }
                },
                {
                    "name": "Add employee note",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            },
                            {
                                "key": "Accept",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"addition_date\": \"2026-05-17\",\n    \"note\": \"ملاحظة عن الموظف\"\n}",
                            "options": {
                                "raw": {
                                    "language": "json"
                                }
                            }
                        },
                        "url": "{{baseUrl}}/api/admin/employees/{{employee_id}}/note"
                    }
                }
            ]
        }
    ]
}
