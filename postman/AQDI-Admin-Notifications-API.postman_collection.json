{
    "info": {
        "_postman_id": "a4b0f06b-39fb-428c-9bab-99400e18c515",
        "name": "AQDI Admin Notifications API",
        "description": "Firebase push notifications (admin). Auth: Bearer {{employee_token}}. Audiences: user, custom_user, employee, custom_employee, all_users, all_employees.",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "variable": [
        {
            "key": "baseUrl",
            "value": "https://aqdi.sa"
        },
        {
            "key": "employee_token",
            "value": ""
        },
        {
            "key": "user_id",
            "value": "1"
        },
        {
            "key": "employee_id",
            "value": "1"
        },
        {
            "key": "fcm_token",
            "value": "DEVICE_FCM_TOKEN"
        }
    ],
    "item": [
        {
            "name": "Auth",
            "item": [
                {
                    "name": "Employee login (save token + fcm)",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application/json",
                                "type": "text"
                            },
                            {
                                "key": "Content-Type",
                                "value": "application/json",
                                "type": "text"
                            }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}/api/admin/employees/login",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "admin",
                                "employees",
                                "login"
                            ]
                        },
                        "description": "Login and optionally save employee FCM token.",
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"email\": \"mohammed@aqdi.com\",\n    \"password\": \"password\",\n    \"fcm_token\": \"{{fcm_token}}\"\n}",
                            "options": {
                                "raw": {
                                    "language": "json"
                                }
                            }
                        }
                    },
                    "response": [],
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "const json = pm.response.json();",
                                    "const token = json?.data?.token;",
                                    "if (token) { pm.collectionVariables.set(\"employee_token\", token); }",
                                    "const id = json?.data?.id;",
                                    "if (id) { pm.collectionVariables.set(\"employee_id\", String(id)); }"
                                ]
                            }
                        }
                    ]
                },
                {
                    "name": "Update employee FCM token",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application/json",
                                "type": "text"
                            },
                            {
