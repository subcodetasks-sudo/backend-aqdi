                        },
                        "description": "Update current employee FCM token.",
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"fcm_token\": \"{{fcm_token}}\"\n}",
                            "options": {
                                "raw": {
                                    "language": "json"
                                }
                            }
                        }
                    },
                    "response": []
                }
            ]
