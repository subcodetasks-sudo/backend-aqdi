{
    "info": {
        "_postman_id": "aqdi-admin-return-contract-status",
        "name": "AQDI Admin — Return contract status (accept_retrun_contract)",
        "description": "Change return-order acceptance on a contract.\n\n**Requires:** `auth:sanctum` employee Bearer token.\n\n**Contract must be a return order** (`contract_status_id = 2`) — use **List return orders** first.\n\n**Endpoint:** `POST /api/admin/orders/{id}/return-contract-status`\n\n**Body:** `{ \"accept_retrun_contract\": true | false }`\n\n**Variables:** `baseUrl`, `employee_token`, `contract_id`",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "auth": {
        "type": "bearer",
        "bearer": [
            {
                "key": "token",
                "value": "{{employee_token}}",
                "type": "string"
            }
        ]
    },
    "variable": [
        { "key": "baseUrl", "value": "http://localhost:8000" },
        { "key": "employee_token", "value": "" },
        { "key": "contract_id", "value": "1" }
    ],
    "item": [
        {
            "name": "00 — Auth",
            "item": [
                {
                    "name": "Employee login (save token)",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "const json = pm.response.json();",
                                    "const token = json?.data?.token ?? json?.token;",
                                    "if (token) {",
                                    "  pm.collectionVariables.set('employee_token', token);",
                                    "}"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ],
                    "request": {
                        "auth": { "type": "noauth" },
                        "method": "POST",
                        "header": [
                            { "key": "Accept", "value": "application/json", "type": "text" },
                            { "key": "Content-Type", "value": "application/json", "type": "text" }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"email\": \"admin@example.com\",\n    \"password\": \"password\"\n}",
                            "options": { "raw": { "language": "json" } }
                        },
                        "url": {
                            "raw": "{{baseUrl}}/api/admin/employees/login",
                            "host": ["{{baseUrl}}"],
                            "path": ["api", "admin", "employees", "login"]
                        }
                    },
                    "response": []
                }
            ]
        },
        {
            "name": "Return orders",
            "item": [
                {
                    "name": "List return orders (contract_status_id = 2)",
                    "request": {
                        "method": "GET",
                        "header": [
                            { "key": "Accept", "value": "application/json", "type": "text" }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}/api/admin/orders/return?per_page=20",
                            "host": ["{{baseUrl}}"],
                            "path": ["api", "admin", "orders", "return"],
                            "query": [
                                { "key": "per_page", "value": "20" }
                            ]
                        },
                        "description": "Pick `id` from response → set collection variable `contract_id`."
                    },
                    "response": []
                },
                {
                    "name": "Contract detail (see accept_retrun_contract)",
                    "request": {
                        "method": "GET",
                        "header": [
                            { "key": "Accept", "value": "application/json", "type": "text" }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}/api/admin/orders/{{contract_id}}",
                            "host": ["{{baseUrl}}"],
                            "path": ["api", "admin", "orders", "{{contract_id}}"]
                        },
                        "description": "Check `contract_summary.accept_retrun_contract` and `accept_retrun_contract_employee`."
                    },
                    "response": []
                }
            ]
        },
        {
            "name": "accept_retrun_contract — JSON",
            "item": [
                {
                    "name": "Accept return contract (true)",
                    "request": {
                        "method": "POST",
                        "header": [
                            { "key": "Accept", "value": "application/json", "type": "text" },
                            { "key": "Content-Type", "value": "application/json", "type": "text" }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"accept_retrun_contract\": true\n}",
                            "options": { "raw": { "language": "json" } }
                        },
                        "url": {
                            "raw": "{{baseUrl}}/api/admin/orders/{{contract_id}}/return-contract-status",
                            "host": ["{{baseUrl}}"],
                            "path": [
                                "api",
                                "admin",
                                "orders",
                                "{{contract_id}}",
                                "return-contract-status"
                            ]
                        },
                        "description": "Sets accept_retrun_contract = true and records authenticated employee."
                    },
                    "response": []
                },
                {
                    "name": "Reject return contract (false)",
                    "request": {
                        "method": "POST",
                        "header": [
                            { "key": "Accept", "value": "application/json", "type": "text" },
                            { "key": "Content-Type", "value": "application/json", "type": "text" }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"accept_retrun_contract\": false\n}",
                            "options": { "raw": { "language": "json" } }
                        },
                        "url": {
                            "raw": "{{baseUrl}}/api/admin/orders/{{contract_id}}/return-contract-status",
                            "host": ["{{baseUrl}}"],
                            "path": [
                                "api",
                                "admin",
                                "orders",
                                "{{contract_id}}",
                                "return-contract-status"
                            ]
                        },
                        "description": "Sets accept_retrun_contract = false and records authenticated employee."
                    },
                    "response": []
                }
            ]
        }
    ]
}
