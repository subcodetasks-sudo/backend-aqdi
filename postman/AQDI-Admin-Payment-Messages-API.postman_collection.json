{
    "info": {
        "_postman_id": "3be0561b-d741-4c00-8258-fbc0191bf0f7",
        "name": "AQDI Admin Payment Messages API",
        "description": "Admin CRUD for payment success/failed messages.\n\nFields:\n- type: success | failed (unique)\n- message\n- button_text / button_link\n- button_text_2 / button_link_2",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "variable": [
        {
            "key": "baseUrl",
            "value": "http://localhost:8000"
        },
        {
            "key": "employee_token",
            "value": ""
        },
        {
            "key": "payment_message_id",
            "value": "1"
        }
    ],
    "item": [
        {
            "name": "Payment Messages",
            "item": [
                {
                    "name": "List payment messages",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application/json",
                                "type": "text"
                            },
                            {
                                "key": "Content-Type",
                                "value": "application/json",
                                "type": "text"
                            },
                            {
                                "key": "Authorization",
                                "value": "Bearer {{employee_token}}",
                                "type": "text"
                            }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}/api/admin/payment-messages?per_page=20",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "admin",
                                "payment-messages"
                            ],
                            "query": [
                                {
                                    "key": "type",
                                    "value": "success",
                                    "disabled": true
                                },
                                {
                                    "key": "per_page",
                                    "value": "20"
                                }
                            ]
                        },
                        "description": "List success/failed message configs."
                    },
                    "response": []
                },
                {
                    "name": "Create success message",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application/json",
                                "type": "text"
                            },
                            {
                                "key": "Content-Type",
                                "value": "application/json",
                                "type": "text"
                            },
                            {
                                "key": "Authorization",
                                "value": "Bearer {{employee_token}}",
                                "type": "text"
                            }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}/api/admin/payment-messages",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "admin",
                                "payment-messages"
                            ]
                        },
                        "description": "Create success payment message.",
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"type\": \"success\",\n    \"message\": \"تم الدفع بنجاح\",\n    \"button_text\": \"عرض العقد\",\n    \"button_link\": \"https://example.com/contracts\",\n    \"button_text_2\": \"الصفحة الرئيسية\",\n    \"button_link_2\": \"https://example.com\"\n}",
                            "options": {
                                "raw": {
                                    "language": "json"
                                }
                            }
                        }
                    },
                    "response": [],
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "const json = pm.response.json();",
                                    "const id = json?.data?.id;",
                                    "if (id) { pm.collectionVariables.set(\"payment_message_id\", String(id)); }"
                                ]
                            }
                        }
                    ]
                },
                {
                    "name": "Create failed message",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
