    ],
    "variable": [
        {
            "key": "baseUrl",
            "value": "http:\/\/localhost:8000",
            "type": "default"
        },
        {
            "key": "token",
            "value": "",
            "type": "secret"
        },
        {
            "key": "contract_id",
            "value": "1",
            "type": "default"
        },
        {
            "key": "contract_uuid",
            "value": "",
            "type": "default"
        },
        {
            "key": "search_term",
            "value": "101",
            "type": "default"
        }
    ],
    "auth": {
        "type": "bearer",
        "bearer": [
            {
                "key": "token",
                "value": "{{token}}",
                "type": "string"
            }
        ]
    }
