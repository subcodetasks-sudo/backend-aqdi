{
    "info": {
        "_postman_id": "7ace1b58-7c9d-4caf-97f0-2feab57c28be",
        "name": "AQDI Contracts API (V2)",
        "description": "Contract endpoints from routes\/api_v2.php.\n\nBase path: `{{baseUrl}}\/api\/v2`\n\nRequires `auth:sanctum` Bearer token (except public routes).\n\n1. Set `baseUrl` and `token`\n2. Run Start contract → save `contract_id` \/ `uuid` from response",
        "schema": "https:\/\/schema.getpostman.com\/json\/collection\/v2.1.0\/collection.json",
        "_exporter_id": "aqdi-blade"
    },
    "item": [
        {
            "name": "Contract creation (steps)",
            "item": [
                {
                    "name": "Start contract",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application\/json",
                                "type": "text"
                            },
                            {
                                "key": "Content-Type",
                                "value": "application\/json",
                                "type": "text"
                            }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}\/api\/v2\/contract\/start",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "v2",
                                "contract",
                                "start"
                            ]
                        },
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"contract_type\": \"housing\",\n    \"instrument_type\": \"old_handwritten\",\n    \"is_real\": false\n}",
                            "options": {
                                "raw": {
                                    "language": "json"
                                }
                            }
                        },
                        "description": "Creates a new contract. Returns contract_id and uuid."
                    },
                    "response": []
                },
                {
                    "name": "Step 1 — property details",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application\/json",
                                "type": "text"
                            },
                            {
                                "key": "Content-Type",
                                "value": "application\/json",
                                "type": "text"
                            }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}\/api\/v2\/contract\/step1",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "v2",
                                "contract",
                                "step1"
                            ]
                        },
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"id\": \"{{contract_id}}\",\n    \"number_of_floors\": 2,\n    \"property_type_id\": 1,\n    \"property_usages_id\": 1,\n    \"number_of_units_in_realestate\": 4\n}",
                            "options": {
                                "raw": {
                                    "language": "json"
                                }
                            }
                        },
                        "description": "File fields (image_instrument_from_the_front\/back) use multipart\/form-data in Postman."
                    },
                    "response": []
                },
                {
                    "name": "Step 2 — address",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application\/json",
                                "type": "text"
                            },
                            {
                                "key": "Content-Type",
                                "value": "application\/json",
                                "type": "text"
                            }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}\/api\/v2\/contract\/step2",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "v2",
                                "contract",
                                "step2"
                            ]
                        },
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"id\": \"{{contract_id}}\",\n    \"property_place_id\": 1,\n    \"property_city_id\": 1,\n    \"neighborhood\": \"حي النخيل\",\n    \"street\": \"شارع الملك\",\n    \"building_number\": \"12\",\n    \"postal_code\": \"12345\",\n    \"extra_figure\": \"1234\"\n}",
                            "options": {
                                "raw": {
                                    "language": "json"
                                }
                            }
                        }
                    },
                    "response": []
                },
                {
                    "name": "Step 3 — owner",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application\/json",
                                "type": "text"
                            },
                            {
                                "key": "Content-Type",
                                "value": "application\/json",
                                "type": "text"
                            }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}\/api\/v2\/contract\/step3",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "v2",
                                "contract",
                                "step3"
                            ]
                        },
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"id\": \"{{contract_id}}\",\n    \"type_dob_property_owner\": \"hijri\",\n    \"name_owner\": \"اسم المالك\",\n    \"property_owner_id_num\": \"1234567890\",\n    \"property_owner_dob_day\": \"15\",\n    \"property_owner_dob_month\": \"06\",\n    \"property_owner_dob_year\": \"1410\",\n    \"property_owner_mobile\": \"0512345678\",\n    \"property_owner_iban\": \"SA0380000000608010167500\",\n    \"add_legal_agent_of_owner\": \"0\",\n    \"notes_edits\": \"ملاحظات التعديلات — حقل اختياري\"\n}",
                            "options": {
                                "raw": {
                                    "language": "json"
                                }
                            }
                        },
                        "description": "Optional notes_edits. Agent\/owner file fields use multipart."
                    },
                    "response": []
                },
                {
                    "name": "Step 4 — tenant",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application\/json",
                                "type": "text"
                            },
                            {
                                "key": "Content-Type",
                                "value": "application\/json",
                                "type": "text"
                            }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}\/api\/v2\/contract\/step4",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "v2",
                                "contract",
                                "step4"
                            ]
                        },
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"id\": \"{{contract_id}}\",\n    \"tenant_name\": \"اسم المستأجر\",\n    \"type_tenant_dob\": \"hijri\",\n    \"tenant_id_num\": \"1098765432\",\n    \"tenant_dob_day\": \"01\",\n    \"tenant_dob_month\": \"01\",\n    \"tenant_dob_year\": \"1415\",\n    \"tenant_mobile\": \"0598765432\"\n}",
                            "options": {
                                "raw": {
                                    "language": "json"
                                }
                            }
                        }
                    },
                    "response": []
                },
                {
                    "name": "Step 5 — unit details",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application\/json",
                                "type": "text"
                            },
                            {
                                "key": "Content-Type",
                                "value": "application\/json",
                                "type": "text"
                            }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}\/api\/v2\/contract\/step5",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "v2",
                                "contract",
                                "step5"
                            ]
                        },
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"id\": \"{{contract_id}}\",\n    \"unit_type_id\": 1,\n    \"unit_usage_id\": 1,\n    \"unit_number\": \"101\",\n    \"unit_area\": \"120\",\n    \"kitchen_tank\": 0,\n    \"furnished\": 0,\n    \"electricity_meter\": 1,\n    \"water_meter\": 1\n}",
                            "options": {
                                "raw": {
                                    "language": "json"
                                }
                            }
                        }
                    },
                    "response": []
                },
                {
                    "name": "Step 6 — terms & payment (tenant_role_ids)",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application\/json",
                                "type": "text"
                            },
                            {
                                "key": "Content-Type",
                                "value": "application\/json",
                                "type": "text"
                            }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}\/api\/v2\/contract\/step6",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "v2",
                                "contract",
                                "step6"
                            ]
                        },
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"id\": \"{{contract_id}}\",\n    \"type_contract_starting_date\": \"hijri\",\n    \"contract_starting_date_day\": \"01\",\n    \"contract_starting_date_month\": \"01\",\n    \"contract_starting_date_year\": \"1447\",\n    \"contract_term_in_years\": 1,\n    \"annual_rent_amount_for_the_unit\": 24000,\n    \"payment_type_id\": 1,\n    \"conditions\": false,\n    \"tenant_roles\": true,\n    \"tenant_role_ids\": [\n        1,\n        2\n    ],\n    \"additional_terms\": false\n}",
                            "options": {
                                "raw": {
                                    "language": "json"
                                }
                            }
                        },
                        "description": "Preferred: tenant_role_ids array. Legacy single tenant_role_id still accepted."
                    },
                    "response": []
                },
                {
                    "name": "Step 6 — legacy tenant_role_id",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application\/json",
                                "type": "text"
                            },
                            {
                                "key": "Content-Type",
                                "value": "application\/json",
                                "type": "text"
                            }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}\/api\/v2\/contract\/step6",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "v2",
                                "contract",
                                "step6"
                            ]
                        },
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"id\": \"{{contract_id}}\",\n    \"type_contract_starting_date\": \"hijri\",\n    \"contract_starting_date_day\": \"01\",\n    \"contract_starting_date_month\": \"01\",\n    \"contract_starting_date_year\": \"1447\",\n    \"contract_term_in_years\": 1,\n    \"annual_rent_amount_for_the_unit\": 24000,\n    \"payment_type_id\": 1,\n    \"conditions\": false,\n    \"tenant_roles\": true,\n    \"tenant_role_id\": 1,\n    \"additional_terms\": false\n}",
                            "options": {
                                "raw": {
                                    "language": "json"
                                }
                            }
                        }
                    },
                    "response": []
                },
                {
                    "name": "Set contract draft",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application\/json",
                                "type": "text"
                            },
                            {
                                "key": "Content-Type",
                                "value": "application\/json",
                                "type": "text"
                            }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}\/api\/v2\/contract\/draft",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "v2",
                                "contract",
                                "draft"
                            ]
                        },
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"id\": \"{{contract_id}}\",\n    \"is_draft\": true\n}",
                            "options": {
                                "raw": {
                                    "language": "json"
                                }
                            }
                        },
                        "description": "Set whether the contract is saved as a draft (true) or not (false). Call after step 6 or when the client is ready to choose."
                    },
                    "response": []
                }
            ]
        },
        {
            "name": "Uncompleted contracts",
            "item": [
                {
                    "name": "Check uncompleted contract",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application\/json",
                                "type": "text"
                            }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}\/api\/v2\/contract\/check-uncompleted-contract",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "v2",
                                "contract",
                                "check-uncompleted-contract"
                            ]
                        },
                        "description": "Returns whether the authenticated user has an incomplete contract. When check=true, response includes contract_id, uuid, and current step."
                    },
                    "response": []
                },
                {
                    "name": "Get uncompleted contract step",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application\/json",
                                "type": "text"
                            },
                            {
                                "key": "Content-Type",
                                "value": "application\/json",
                                "type": "text"
                            }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}\/api\/v2\/contract\/uncompleted-contract",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "v2",
                                "contract",
                                "uncompleted-contract"
                            ]
                        },
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"uuid\": \"{{contract_uuid}}\"\n}",
                            "options": {
                                "raw": {
                                    "language": "json"
                                }
                            }
                        },
                        "description": "Resume an incomplete contract by uuid. Returns current step plus saved data for all previous steps (step1…step6 resources, same shape as step endpoints). Skips steps 1–2 for lease_renewal\/sublease_agreement; skips step 4 for lease_renewal."
                    },
                    "response": []
                }
            ]
        },
