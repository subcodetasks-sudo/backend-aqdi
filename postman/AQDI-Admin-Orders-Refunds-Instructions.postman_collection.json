{
    "info": {
        "_postman_id": "aqdi-admin-orders-refunds-instructions",
        "name": "AQDI Admin — Orders, Refunds & Instruction Sections",
        "description": "Admin APIs added/updated in this module:\n\n- **Orders** — list, return (status=2), incomplete, complete, show, partial update\n- **Refundable contracts** — employee submit + admin approval\n- **Instruction sections** — `routes/admin.php` instruction-sections group\n\n**Variables**\n- `baseUrl` — e.g. `http://localhost:8000`\n- `employee_token` — Bearer for employee routes (login under Employees collection)\n- `contract_id` — contract id from orders/return\n- `refund_id` — refundable_contracts.id\n- `instruction_section_id` — instruction section id\n- `instruction_image_id` — image id under a section",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "variable": [
        { "key": "baseUrl", "value": "http://localhost:8000" },
        { "key": "employee_token", "value": "" },
        { "key": "contract_id", "value": "1" },
        { "key": "refund_id", "value": "1" },
        { "key": "instruction_section_id", "value": "1" },
        { "key": "instruction_image_id", "value": "1" }
    ],
    "item": [
        {
            "name": "Orders",
            "description": "Contract orders under `/api/admin/orders`. Return list uses `contract_status_id = 2` (unchanged).",
            "item": [
                {
                    "name": "List orders",
                    "request": {
                        "method": "GET",
                        "header": [{ "key": "Accept", "value": "application/json" }],
                        "url": {
                            "raw": "{{baseUrl}}/api/admin/orders?per_page=20&page=1",
                            "host": ["{{baseUrl}}"],
                            "path": ["api", "admin", "orders"],
                            "query": [
                                { "key": "per_page", "value": "20" },
                                { "key": "page", "value": "1" },
                                { "key": "is_completed", "value": "0", "disabled": true },
                                { "key": "search", "value": "", "disabled": true }
                            ]
                        }
                    }
                },
                {
                    "name": "Return orders (contract_status_id = 2)",
                    "request": {
                        "method": "GET",
                        "header": [{ "key": "Accept", "value": "application/json" }],
                        "url": {
                            "raw": "{{baseUrl}}/api/admin/orders/return?per_page=20",
                            "host": ["{{baseUrl}}"],
                            "path": ["api", "admin", "orders", "return"],
                            "query": [{ "key": "per_page", "value": "20" }]
                        },
                        "description": "Eligible contracts for refund requests. Use `id` as `contract_id` when submitting refund."
                    }
                },
                {
                    "name": "Incomplete orders (is_completed = 0)",
                    "request": {
                        "method": "GET",
                        "header": [{ "key": "Accept", "value": "application/json" }],
                        "url": {
                            "raw": "{{baseUrl}}/api/admin/orders/incomplete/list?per_page=20",
                            "host": ["{{baseUrl}}"],
                            "path": ["api", "admin", "orders", "incomplete", "list"],
                            "query": [{ "key": "per_page", "value": "20" }]
                        }
                    }
                },
                {
                    "name": "Complete orders (is_completed = 1)",
                    "request": {
                        "method": "GET",
                        "header": [{ "key": "Accept", "value": "application/json" }],
                        "url": {
                            "raw": "{{baseUrl}}/api/admin/orders/complete/list?per_page=20",
                            "host": ["{{baseUrl}}"],
                            "path": ["api", "admin", "orders", "complete", "list"],
                            "query": [{ "key": "per_page", "value": "20" }]
                        }
                    }
                },
                {
                    "name": "Show contract (full detail)",
                    "request": {
                        "method": "GET",
                        "header": [{ "key": "Accept", "value": "application/json" }],
                        "url": "{{baseUrl}}/api/admin/orders/{{contract_id}}"
                    }
                },
                {
                    "name": "Update contract (partial — any field)",
                    "request": {
                        "method": "POST",
                        "header": [
                            { "key": "Accept", "value": "application/json" },
                            { "key": "Content-Type", "value": "application/json" }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"annual_rent_amount_for_the_unit\": \"15000\",\n    \"notes_edits\": \"تعديل من لوحة التحكم\",\n    \"step\": 6\n}",
                            "options": { "raw": { "language": "json" } }
                        },
                        "url": "{{baseUrl}}/api/admin/orders/{{contract_id}}",
                        "description": "Send only fields to change. All contract columns are optional (`sometimes` + `nullable`). Cannot update: id, uuid, created_at, updated_at."
                    }
                },
                {
                    "name": "Update contract status only",
                    "request": {
                        "method": "POST",
                        "header": [
                            { "key": "Accept", "value": "application/json" },
                            { "key": "Content-Type", "value": "application/json" }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"contract_status_id\": 2\n}",
                            "options": { "raw": { "language": "json" } }
                        },
                        "url": "{{baseUrl}}/api/admin/orders/{{contract_id}}/contract-status"
                    }
                }
            ]
        },
        {
            "name": "Refundable contracts",
            "description": "طلبات استرجاع — contract must be from return orders (`contract_status_id = 2`).",
            "item": [
                {
                    "name": "Submit refund request (employee)",
                    "request": {
                        "auth": {
                            "type": "bearer",
                            "bearer": [{ "key": "token", "value": "{{employee_token}}", "type": "string" }]
                        },
                        "method": "POST",
                        "header": [
                            { "key": "Accept", "value": "application/json" },
                            { "key": "Content-Type", "value": "application/json" }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"contract_id\": {{contract_id}},\n    \"refund_amount\": 500,\n    \"notes\": null\n}",
                            "options": { "raw": { "language": "json" } }
                        },
                        "url": "{{baseUrl}}/api/admin/refundable-contracts",
                        "description": "Requires Bearer employee token. `notes` optional. Or use `draft_contract_number`: \"000042\" instead of contract_id."
                    },
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "const json = pm.response.json();",
                                    "const id = json?.data?.id;",
                                    "if (id) pm.collectionVariables.set('refund_id', String(id));"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ]
                },
                {
                    "name": "List refund requests",
                    "request": {
                        "method": "GET",
                        "header": [{ "key": "Accept", "value": "application/json" }],
                        "url": {
                            "raw": "{{baseUrl}}/api/admin/analytics/refunds/contracts?period=today&per_page=20",
                            "host": ["{{baseUrl}}"],
                            "path": ["api", "admin", "analytics", "refunds", "contracts"],
                            "query": [
                                { "key": "period", "value": "today", "description": "today|week|month|year|total" },
                                { "key": "per_page", "value": "20" },
                                { "key": "admin_confirmed", "value": "false", "disabled": true }
                            ]
                        }
                    }
                },
                {
                    "name": "Show refund request",
                    "request": {
                        "method": "GET",
                        "header": [{ "key": "Accept", "value": "application/json" }],
                        "url": "{{baseUrl}}/api/admin/analytics/refunds/contracts/{{refund_id}}"
                    }
                },
                {
                    "name": "Approve refund (موافقة الإدارة)",
                    "request": {
                        "method": "POST",
                        "header": [
                            { "key": "Accept", "value": "application/json" },
                            { "key": "Content-Type", "value": "application/json" }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"admin_confirmed\": true\n}",
                            "options": { "raw": { "language": "json" } }
                        },
                        "url": "{{baseUrl}}/api/admin/analytics/refunds/contracts/{{refund_id}}",
                        "description": "Sets is_refunded = true. Optional: refund_amount, notes."
                    }
                },
                {
                    "name": "Reject refund (لم تتم الموافقة)",
                    "request": {
                        "method": "POST",
                        "header": [
                            { "key": "Accept", "value": "application/json" },
                            { "key": "Content-Type", "value": "application/json" }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"admin_confirmed\": false\n}",
                            "options": { "raw": { "language": "json" } }
                        },
                        "url": "{{baseUrl}}/api/admin/analytics/refunds/contracts/{{refund_id}}"
                    }
                },
                {
                    "name": "Update refund data + approve",
                    "request": {
                        "method": "POST",
                        "header": [
                            { "key": "Accept", "value": "application/json" },
                            { "key": "Content-Type", "value": "application/json" }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"admin_confirmed\": true,\n    \"refund_amount\": 125.99,\n    \"notes\": \"تمت المراجعة\"\n}",
                            "options": { "raw": { "language": "json" } }
                        },
                        "url": "{{baseUrl}}/api/admin/analytics/refunds/contracts/{{refund_id}}"
                    }
                }
            ]
        },
        {
            "name": "Instruction sections",
            "description": "صور تعليمية أو إعلانية — `instruction-sections` routes (admin.php 336-347).",
            "item": [
                {
                    "name": "List sections",
                    "request": {
                        "method": "GET",
                        "header": [{ "key": "Accept", "value": "application/json" }],
                        "url": {
                            "raw": "{{baseUrl}}/api/admin/instruction-sections?per_page=20",
                            "host": ["{{baseUrl}}"],
                            "path": ["api", "admin", "instruction-sections"],
                            "query": [{ "key": "per_page", "value": "20" }]
                        }
                    }
                },
                {
                    "name": "Show section",
                    "request": {
                        "method": "GET",
                        "header": [{ "key": "Accept", "value": "application/json" }],
                        "url": "{{baseUrl}}/api/admin/instruction-sections/{{instruction_section_id}}"
                    }
                },
                {
                    "name": "Update section",
                    "request": {
                        "method": "POST",
                        "header": [
                            { "key": "Accept", "value": "application/json" },
                            { "key": "Content-Type", "value": "application/json" }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"title_ar\": \"عنوان القسم\",\n    \"description_ar\": \"وصف اختياري\",\n    \"sort_order\": 1\n}",
                            "options": { "raw": { "language": "json" } }
                        },
                        "url": "{{baseUrl}}/api/admin/instruction-sections/{{instruction_section_id}}"
                    }
                },
                {
                    "name": "Toggle section active",
                    "request": {
                        "method": "POST",
                        "header": [
                            { "key": "Accept", "value": "application/json" },
                            { "key": "Content-Type", "value": "application/json" }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"is_active\": true\n}",
                            "options": { "raw": { "language": "json" } }
                        },
                        "url": "{{baseUrl}}/api/admin/instruction-sections/{{instruction_section_id}}/toggle"
                    }
                },
                {
                    "name": "Delete section",
                    "request": {
                        "method": "POST",
                        "header": [{ "key": "Accept", "value": "application/json" }],
                        "url": "{{baseUrl}}/api/admin/instruction-sections/{{instruction_section_id}}/delete"
                    }
                },
                {
                    "name": "Upload section image",
                    "request": {
                        "method": "POST",
                        "header": [{ "key": "Accept", "value": "application/json" }],
                        "body": {
                            "mode": "formdata",
                            "formdata": [
                                { "key": "image", "type": "file", "src": [] },
                                { "key": "title_ar", "value": "عنوان الصورة", "type": "text" },
                                { "key": "sort_order", "value": "1", "type": "text" }
                            ]
                        },
                        "url": "{{baseUrl}}/api/admin/instruction-sections/{{instruction_section_id}}/images",
                        "description": "multipart: image (required), title_ar, sort_order optional."
                    },
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "const json = pm.response.json();",
                                    "const id = json?.data?.id;",
                                    "if (id) pm.collectionVariables.set('instruction_image_id', String(id));"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ]
                },
                {
                    "name": "Delete section image",
                    "request": {
                        "method": "POST",
                        "header": [{ "key": "Accept", "value": "application/json" }],
                        "url": "{{baseUrl}}/api/admin/instruction-sections/{{instruction_section_id}}/images/{{instruction_image_id}}/delete"
                    }
                }
            ]
        }
    ]
}
