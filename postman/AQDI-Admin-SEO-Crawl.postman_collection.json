{
    "info": {
        "_postman_id": "5a6e2fd6-7ed9-4492-a650-5e98698b02ce",
        "name": "AQDI Admin SEO Crawl",
        "description": "Technical crawl and site audit for aqdi.sa (`/api/admin/seo-crawl`).\n\n1. Import this collection.\n2. Set `baseUrl` (e.g. http://localhost:8000 or https://aqdi.sa).\n3. Run **Employee login** — token is saved to `employee_token`.\n4. The employee role needs `seo_crawl.view` and `seo_crawl.create`.\n5. **Run crawl** returns 202 (`queued`). Poll **Dashboard** until `status` is `completed` or `stopped`.\n6. **Stop crawl** cancels the in-progress scan.\n\nStatuses: never_run | queued | running | completed | stopped | failed",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "variable": [
        {
            "key": "baseUrl",
            "value": "http://localhost:8000"
        },
        {
            "key": "employee_token",
            "value": ""
        },
        {
            "key": "seo_crawl_run_id",
            "value": ""
        }
    ],
    "auth": {
        "type": "bearer",
        "bearer": [
            {
                "key": "token",
                "value": "{{employee_token}}",
                "type": "string"
            }
        ]
    },
    "item": [
        {
            "name": "Auth",
            "item": [
                {
                    "name": "Employee login (save token)",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application/json",
                                "type": "text"
                            },
                            {
                                "key": "Content-Type",
                                "value": "application/json",
                                "type": "text"
                            }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}/api/admin/employees/login",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "admin",
                                "employees",
                                "login"
                            ]
                        },
                        "description": "Saves `data.token` to collection variable `employee_token`.",
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"email\": \"admin@example.com\",\n    \"password\": \"password\"\n}",
                            "options": {
                                "raw": {
                                    "language": "json"
                                }
                            }
                        }
                    },
                    "response": [],
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "const json = pm.response.json();",
                                    "const token = json?.data?.token ?? json?.token;",
                                    "if (token) { pm.collectionVariables.set(\"employee_token\", token); }"
                                ]
                            }
                        }
                    ]
                }
            ]
        },
