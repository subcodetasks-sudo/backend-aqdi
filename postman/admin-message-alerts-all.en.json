{
  "title": "Admin Message Alerts — export all messages",
  "description": "Returns every message alert grouped by audience, section, and item (no pagination). Base: /api/admin",
  "version": "1.0.0",
  "endpoints": [
    {
      "name": "All messages (full tree + flat list)",
      "method": "GET",
      "path": "/message-alerts/all",
      "query_parameters": {
        "type": {
          "optional": true,
          "values": ["client", "property", "employee"],
          "description": "Filter one audience; omit for all types."
        }
      },
      "examples": [
        "/api/admin/message-alerts/all",
        "/api/admin/message-alerts/all?type=client",
        "/api/admin/message-alerts/all?type=property"
      ]
    },
    {
      "name": "Types overview (cards)",
      "method": "GET",
      "path": "/message-alerts/types"
    },
    {
      "name": "Paginated list by audience",
      "method": "GET",
      "path": "/message-alerts/{client|property|employee}",
      "query_parameters": {
        "search": { "optional": true, "description": "Filter message text" },
        "message_alert_section_id": { "optional": true, "type": "integer" },
        "message_alert_section_item_id": { "optional": true, "type": "integer" },
        "per_page": { "optional": true, "default": 20, "max": 100 }
      }
    }
  ],
  "response_all_shape": {
    "success": true,
    "message": "string",
    "data": {
      "types": [
        {
          "key": "client",
          "label_ar": "رسائل التطبيقية للعميل",
          "label_en": "Client application messages",
          "show_in_overview": true,
          "sections_count": 0,
          "messages_count": 0
        }
      ],
      "audiences": [
        {
          "type": "client",
          "type_label_ar": "string",
          "type_label_en": "string",
          "sections_count": 0,
          "messages_count": 0,
          "sections": [
            {
              "id": 1,
              "name_ar": "string",
              "name_en": "string",
              "type": "client",
              "sort_order": 0,
              "messages_count": 0,
              "items": [
                {
                  "id": 1,
                  "message_alert_section_id": 1,
                  "name_ar": "string",
                  "name_en": "string",
                  "sort_order": 0,
                  "messages_count": 0,
                  "messages": [
                    {
                      "id": 1,
                      "type": "client",
                      "message": "string",
                      "message_alert_section_id": 1,
                      "message_alert_section_item_id": 1,
                      "section": { "id": 1, "name_ar": "string", "name_en": "string", "type": "client" },
                      "section_item": { "id": 1, "name_ar": "string", "name_en": "string" },
                      "created_at": "Y-m-d H:i:s",
                      "updated_at": "Y-m-d H:i:s"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ],
      "messages": [],
      "total_messages": 0
    }
  }
}
